# ---------------------------------------------------------------------------
# Database (required)
# ---------------------------------------------------------------------------
# Local MongoDB:  mongodb://127.0.0.1:27017/portfolio
# MongoDB Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/portfolio?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/portfolio

# ---------------------------------------------------------------------------
# Authentication (required)
# ---------------------------------------------------------------------------
# Signs the admin session JWT. Must be at least 32 characters.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=

# How long an admin session stays valid, in seconds (default: 7 days).
SESSION_MAX_AGE=604800

# ---------------------------------------------------------------------------
# Image uploads (optional)
# ---------------------------------------------------------------------------
# "local"      — writes to public/uploads. Zero config, great for development.
IMAGE_UPLOAD_PROVIDER=local

# Maximum accepted upload size in megabytes (default: 5).
MAX_UPLOAD_MB=5

# ---------------------------------------------------------------------------
# Analytics (optional)
# ---------------------------------------------------------------------------
# Leave blank to disable. Can also be managed from Admin → Settings.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
