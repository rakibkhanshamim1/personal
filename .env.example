# ---------------------------------------------------------------------------
# Database (required)
# ---------------------------------------------------------------------------
# Local MongoDB:  mongodb://127.0.0.1:27017/portfolio
# MongoDB Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/portfolio?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/portfolio

# ---------------------------------------------------------------------------
# Authentication (required)
# ---------------------------------------------------------------------------
# Signs the admin session JWT. Must be at least 32 characters.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=

# How long an admin session stays valid, in seconds (default: 7 days).
SESSION_MAX_AGE=604800

# ---------------------------------------------------------------------------
# Site (required)
# ---------------------------------------------------------------------------
# Absolute public origin, no trailing slash. Used for canonical URLs,
# Open Graph tags, the sitemap and JSON-LD.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Seeding (required only to run `npm run seed`)
# ---------------------------------------------------------------------------
# Credentials for the initial admin account. The seed script reads them from
# here so no password is ever hardcoded in the repository.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
ADMIN_NAME=Site Admin

# ---------------------------------------------------------------------------
# Image uploads (optional)
# ---------------------------------------------------------------------------
# "local"      — writes to public/uploads. Zero config, great for development.
#                Not suitable for serverless/ephemeral hosts such as Vercel.
# "cloudinary" — uploads to Cloudinary. Required for serverless deployments.
IMAGE_UPLOAD_PROVIDER=local

# Only needed when IMAGE_UPLOAD_PROVIDER=cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional folder to namespace uploads inside your Cloudinary account.
CLOUDINARY_FOLDER=portfolio

# Maximum accepted upload size in megabytes (default: 5).
MAX_UPLOAD_MB=5

# ---------------------------------------------------------------------------
# Analytics (optional)
# ---------------------------------------------------------------------------
# Leave blank to disable. Can also be managed from Admin → Settings.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
